{
  "name": "opencode-session-surf",
  "version": "0.1.0",
  "description": "Session list sidebar plugin for opencode TUI with cross-instance status sync and fuzzy session switching",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luchev/opencode-session-surf.git"
  },
  "type": "module",
  "exports": {
    "./tui": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build ./index.tsx --outdir dist --target=bun --external @opencode-ai/plugin --external @opencode-ai/sdk --external solid-js --external @opentui/core --external @opentui/solid && cp index.d.ts dist/",
    "dev": "bun build ./index.tsx --outdir dist --target=bun --external @opencode-ai/plugin --external @opencode-ai/sdk --external solid-js --external @opentui/core --external @opentui/solid --watch",
    "prepublishOnly": "bun run build"
  },
  "keywords": ["opencode", "opencode-plugin", "tui", "sessions", "sidebar"],
  "dependencies": {
    "@opencode-ai/plugin": "1.18.15",
    "@opencode-ai/sdk": "1.18.15",
    "@opentui/core": "0.4.5",
    "@opentui/solid": "0.4.5",
    "solid-js": "^1.9.12"
  }
}
